# ============================================================
# Ace — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit real secrets. NEVER put the executor key in NEXT_PUBLIC_*.
# ============================================================

# --- Monad Testnet network (public, safe to expose to client) ---
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143

# --- Deployed Ace contracts on Monad Testnet (fill after `forge script`) ---
NEXT_PUBLIC_ACE_CONTRACT_ADDRESS=0xfd95f956d46230fdaa654813712ffbeeb4ced361
NEXT_PUBLIC_P2P_CONTRACT_ADDRESS=0x5deffd0be3b2dfc4cb7a9359e82a9c806f41fbda

# --- Executor / relayer key (SERVER-SIDE ONLY — never NEXT_PUBLIC) ---
# This wallet must be the authorized operator of AceSettlement and hold MON for gas.
ACE_EXECUTOR_PRIVATE_KEY=5afea09852363adb489bc7a46d8546b6d6fa71d6747792ea3a6cc3dfd3f205ca

# --- External prediction market (RushTrade) ---
# If you have a verified, deployed RushTrade contract address, put it here.
# If left blank, the RushTrade adapter reports the market as unavailable and,
# when DEMO_MODE=true, a clearly-labeled DEMO_EXTERNAL_MARKET is used instead.
NEXT_PUBLIC_RUSH_TRADE_ADDRESS=

# --- Testnet USDC on Monad (Circle canonical testnet USDC) ---
NEXT_PUBLIC_TESTNET_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# --- Demo mode ---
# When true, unsupported external prediction-market interactions are SIMULATED.
# The UI clearly labels these as "DEMO MODE — NOT AN ON-CHAIN BET".
# A fake Monad transaction hash is NEVER shown.
DEMO_MODE=false
